# Documentation only: configure these in PHP-FPM/process environment.
# This application does not automatically load .env files.
STUDIO_ENV=local
STUDIO_PRODUCTION_URL=
# Existing private persistent storage root; unset for local development.
STUDIO_SHARED_ROOT=

# Production-only callback delivery. Keep disabled until SMTP is configured.
STUDIO_CALLBACK_ENABLED=false
# Existing writable directory outside the public website root, separate per environment.
STUDIO_CALLBACK_STORAGE_DIR=
STUDIO_CALLBACK_FROM=
STUDIO_CALLBACK_TO=
STUDIO_SMTP_HOST=
STUDIO_SMTP_PORT=587
STUDIO_SMTP_SECURITY=tls
STUDIO_SMTP_USERNAME=
STUDIO_SMTP_PASSWORD=
