{
  "name": "getkirby/plainkit",
  "description": "Kirby Plainkit",
  "type": "project",
  "keywords": [
    "kirby",
    "cms",
    "plainkit"
  ],
  "authors": [
    {
      "name": "Bastian Allgeier",
      "email": "bastian@getkirby.com",
      "homepage": "https://getkirby.com"
    }
  ],
  "homepage": "https://getkirby.com",
  "support": {
    "email": "support@getkirby.com",
    "forum": "https://forum.getkirby.com",
    "source": "https://github.com/getkirby/plainkit"
  },
  "require": {
    "php": "~8.5.0",
    "getkirby/cms": "^5.5.3",
    "pixelopen/kirby-asset-version": "^1.1",
    "jreisdorf/kirby-static-site-generator": "^2.4",
    "sylvainjule/locator": "^2.1",
    "medienbaecker/kirby-tiptap": "^1.3"
  },
  "config": {
    "allow-plugins": {
      "getkirby/composer-installer": true,
      "php-http/discovery": true
    },
    "optimize-autoloader": true
  },
  "scripts": {
    "start": [
      "Composer\\Config::disableProcessTimeout",
      "@php -S localhost:8000 kirby/router.php"
    ],
    "test": "@php tests/run.php"
  },
  "require-dev": {
    "bnomei/kirby-mcp": "^1.12"
  }
}
