; Inactive PHP 8.5 FPM template. Create dedicated account and paths first.
[kuhni-staging]
user = kuhni-staging
group = kuhni-staging
listen = /run/php/kuhni-staging.sock
listen.owner = www-data
listen.group = www-data
listen.mode = 0660
pm = ondemand
pm.max_children = 1
pm.process_idle_timeout = 10s
pm.max_requests = 300
clear_env = yes
env[STUDIO_ENV] = staging
env[STUDIO_PRODUCTION_URL] = https://DOMAIN
php_admin_value[memory_limit] = 256M
php_admin_value[upload_max_filesize] = 16M
php_admin_value[post_max_size] = 20M
php_admin_flag[display_errors] = off
php_admin_flag[log_errors] = on
php_admin_value[error_log] = /srv/kuhni/staging/logs/php-error.log
