# Inactive template. Replace DOMAIN and provision paths/certificates before use.
<VirtualHost *:443>
    ServerName design.DOMAIN
    DocumentRoot /srv/kuhni/staging/current
    Protocols h2 http/1.1

    SSLEngine on
    SSLCertificateFile /etc/letsencrypt/live/design.DOMAIN/fullchain.pem
    SSLCertificateKeyFile /etc/letsencrypt/live/design.DOMAIN/privkey.pem

    Header always set X-Robots-Tag "noindex, nofollow, noarchive"
    Header always set Cache-Control "private, no-store"

    <Directory /srv/kuhni/staging/current>
        Options -Indexes +FollowSymLinks
        AllowOverride All
        AuthType Basic
        AuthName "Design preview"
        AuthUserFile /etc/apache2/private/kuhni-design.htpasswd
        Require valid-user
    </Directory>

    <FilesMatch \.php$>
        SetHandler "proxy:unix:/run/php/kuhni-staging.sock|fcgi://localhost/"
    </FilesMatch>

    ErrorLog ${APACHE_LOG_DIR}/kuhni-design-error.log
    CustomLog ${APACHE_LOG_DIR}/kuhni-design-access.log combined
</VirtualHost>
